<Window x:Class="Silent.DownloadManager.App.Views.QualityPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Quality"
        Width="460"
        Height="460"
        MinWidth="400"
        MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Padding="18"
            Background="White"
            BorderBrush="#DFE7F2"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Select Download Quality"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#10233F" />
                <TextBlock x:Name="UrlLabel"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="40"
                           Foreground="#5B6B82"
                           FontSize="12" />
            </StackPanel>

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Orientation="Horizontal"
                        Visibility="Visible">
                <TextBlock Text="Fetching available formats…"
                           Foreground="#5B6B82"
                           FontStyle="Italic" />
            </StackPanel>

            <!-- Format list -->
            <ListBox x:Name="FormatListBox"
                     Grid.Row="2"
                     Margin="0,10,0,0"
                     BorderBrush="#DFE7F2"
                     BorderThickness="1"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     FontSize="13">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="BorderBrush" Value="#EDF1F6" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Error label -->
            <TextBlock x:Name="ErrorLabel"
                       Grid.Row="3"
                       Margin="0,8,0,0"
                       Foreground="#D92D20"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       FontSize="12" />

            <!-- Buttons -->
            <StackPanel Grid.Row="4"
                        Margin="0,14,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}"
                        Background="#E8EEF8"
                        Foreground="#1B2B45"
                        Content="Cancel"
                        Click="CancelButton_Click" />
                <Button x:Name="DownloadButton"
                        Style="{StaticResource DialogButton}"
                        Background="#1769E0"
                        Foreground="White"
                        Content="Download"
                        IsEnabled="False"
                        Click="DownloadButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
